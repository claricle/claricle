module Claricle
  VERSION: String

  type format = Symbol
  type verdict = :yes | :suspicious | :no
  type severity = "error" | "warning" | "info"
  type parse_status = "ok" | "failed"

  # Anything with #puts, which includes StringIO -- not an IO subclass.
  interface _Writable
    def puts: (*untyped) -> void
  end

  # Anything responding to #read, which includes StringIO, not only IO.
  interface _Readable
    # Called with no arguments, and its result used directly.
    def read: () -> String
  end

  def self.detect: (String | _Readable source) -> format

  class Error < StandardError
  end

  class UnknownFormat < Error
  end

  class InvocationError < Error
  end

  class ConversionError < Error
  end

  class UnsupportedFormat < Error
    def initialize: (untyped format, ?untyped operation, ?target: untyped) -> void
  end

  class Image
    attr_reader format: format
    attr_reader path: String?

    def initialize: (format: format, ?path: String?, ?content: String?) -> void
    def self.from_path: (String path) -> Image
    def self.from_content: (String content, ?format: format?) -> Image

    def content: () -> String
    def with_path: [T] () { (String path) -> T } -> T
    def inspection: () -> untyped
    def conformance_report: () -> untyped
    def convert: (to: format) -> untyped
  end

  # Superclass unnamed for the same reason as the models: thor ships no
  # RBS signature, so naming it fails validation.
  class Cli
    # Thor's, called directly by Runner.run.
    def self.start: (Array[String] argv, ?untyped config) -> untyped
    def self.exit_on_failure?: () -> bool
    def version: () -> void

    module Runner
      class Status
        RANGE: Range[Integer]
        attr_reader code: Integer
        def initialize: (Integer code) -> void
      end

      def self.run: (Array[String] argv, ?output: _Writable) -> Integer
    end
  end

  module Models
    # Superclass deliberately unnamed: lutaml-model 0.8.19 ships no
    # signature for Lutaml::Model::Serializable, and naming it makes
    # `rbs validate` fail with NoSuperclassFoundError.
    class Location
      def self.from_json: (String json) -> Location
      def to_json: (*untyped) -> String

      attr_accessor byte_offset: Integer?
      attr_accessor byte_length: Integer?
      attr_accessor line: Integer?
      attr_accessor column: Integer?
      attr_accessor chunk: String?
      attr_accessor node_path: String?
    end

    class Issue
      def self.from_json: (String json) -> Issue
      def to_json: (*untyped) -> String

      SEVERITIES: Array[String]

      attr_accessor severity: severity
      attr_accessor code: String?
      attr_accessor message: String
      attr_accessor location: Location?
    end

    class Report
      def self.from_json: (String json) -> Report
      def to_json: (*untyped) -> String

      attr_accessor source_path: String?
      attr_accessor format: String?
      attr_accessor issues: Array[Issue]
      attr_accessor profile: String?
      attr_accessor validator_version: String?

      # Derived from issues on read, never stored.
      def valid: () -> verdict
    end

    class Inspection
      def self.from_json: (String json) -> Inspection
      def to_json: (*untyped) -> String

      PARSE_STATUSES: Array[String]

      attr_accessor format: String?
      attr_accessor width: Float?
      attr_accessor height: Float?
      attr_accessor dpi: Float?
      attr_accessor color_space: String?
      attr_accessor meta: Hash[untyped, untyped]?
      attr_accessor parse_status: parse_status
      attr_accessor issues: Array[Issue]
    end
  end
end
